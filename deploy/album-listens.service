[Unit]
# Rebuilds the derived v2.album_listens / v2.album_pass_state tables from
# v2.history. They are NOT maintained incrementally, so left alone they go stale
# silently -- they sat ~7 weeks out of date once, which read as "album counting
# is broken" in the dashboard's Favorites tab.
#
# No timer of its own: ingest.service triggers this via OnSuccess=, so it tracks
# v2.history hourly instead of trailing it by up to a day. Full rebuild, ~2s.
Description=Rebuild derived album-listen tables from history
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=andrew
WorkingDirectory=/home/andrew/music-dashboard/ingest
EnvironmentFile=/home/andrew/music-dashboard/app.env
# N comes from albums.core_tracks, which only Spotify can supply, so top up any
# album heard for the first time since the last run before counting. --new-only
# scopes it to those: a handful of requests, usually none. The "-" prefix keeps
# a Spotify outage from blocking the rebuild -- it just falls back to
# total_tracks for those albums until a later run fills them in.
ExecStartPre=-/home/andrew/music-dashboard/venv/bin/python enrich_album_editions.py --new-only
ExecStart=/home/andrew/music-dashboard/venv/bin/python build_album_listens.py
