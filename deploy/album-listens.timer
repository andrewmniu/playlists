[Unit]
Description=Daily rebuild of derived album-listen tables

[Timer]
# 30 min after playlists-daily so the two heavy jobs don't overlap. Anchored to
# Pacific like the other daily units -- a hardcoded UTC time would drift half an
# hour relative to them at each DST change and end up running *before*
# playlists-daily for half the year.
OnCalendar=*-*-* 00:30:00 America/Los_Angeles
Persistent=true

[Install]
WantedBy=timers.target
